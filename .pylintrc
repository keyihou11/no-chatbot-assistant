# Pylint configuration file
# For No-Chatbot project

[MESSAGES CONTROL]
# Disable less important formatting checks, focusing on code logic issues
disable=
    C0303,  # trailing-whitespace
    C0304,  # missing-final-newline
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    W0621,  # redefined-outer-name (too strict)
    R0903,  # too-few-public-methods (not friendly to utility classes)

[FORMAT]
# Maximum line length
max-line-length=100

[BASIC]
# Good variable name pattern
good-names=i,j,k,x,y,z,_,a,b

[DESIGN]
# Minimum number of public methods
min-public-methods=0
